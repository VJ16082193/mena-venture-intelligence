# ── Database ─────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:password@localhost:5432/mena_vc

# ── Pipeline ─────────────────────────────────────────────
PIPELINE_SCHEDULE_HOURS=12
MIN_CONFIDENCE_SCORE=40
SCRAPER_DELAY_SECONDS=2.0

# ── Logging ──────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs

# ── Dashboard ────────────────────────────────────────────
STREAMLIT_SERVER_PORT=8501
DASHBOARD_CACHE_TTL_SECONDS=1800

# ── FX Rates ─────────────────────────────────────────────
FX_REFRESH_DAYS=7

# Optional: ExchangeRate-API key
FX_API_KEY=
